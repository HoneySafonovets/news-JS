{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./out",
    "skipLibCheck": true,
    "module": "esnext",
    "target": "es6",
    "types": ["node"],
    
    "allowSyntheticDefaultImports": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "noImplicitAny": true,

    // Recommended Options
    "strict": true,
  },
  "exclude": ["node_modules", "**/*.spec.ts"]
}
